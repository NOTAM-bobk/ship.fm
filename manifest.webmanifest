{
  "id": "/",
  "name": "snip.fm — 30-second music clips",
  "short_name": "snip.fm",
  "description": "Scroll 30-second music clips, mix your favorite genres, build playlists, and level up your taste.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search music", "short_name": "Search", "url": "./#search" },
    { "name": "Your profile", "short_name": "Profile", "url": "./#profile" }
  ]
}
